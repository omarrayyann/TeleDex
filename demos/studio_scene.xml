    <body pos="0.25 0 0.12"><freejoint/><geom type="box" size="0.04 0.04 0.04" rgba="0.85 0.8 0.3 1"/></body>
    <body pos="0.4 0.06 0.05"><freejoint/><geom type="sphere" size="0.05" rgba="0.7 0.45 0.9 1"/></body>
